# --- Modelo ---
PREDICTOR=local                      # local | sagemaker
SAGEMAKER_ENDPOINT=shopfast-xgb-endpoint
AWS_REGION=us-east-1
MODEL_PATH=/data/model/xgboost-model.json
# --- Seguridad ---
API_KEYS=cambia-esta-llave,llave-dashboard
DASHBOARD_API_KEY=llave-dashboard
RATE_LIMIT=60/minute
# --- Infraestructura ---
DOMAIN=localhost                     # en AWS: 3-90-12-34.sslip.io (IP pública con guiones)
RABBITMQ_USER=shopfast
RABBITMQ_PASSWORD=cambia-esta-clave
RABBITMQ_URL=amqp://shopfast:cambia-esta-clave@rabbitmq:5672/
POSTGRES_PASSWORD=cambia-esta-clave
DATABASE_URL=postgresql://shopfast:cambia-esta-clave@postgres:5432/shopfast
